# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# LLM -----------------------------------------------------------------------
# Any OpenAI-compatible endpoint works. Pick one block, delete or comment the
# rest. Groq is the default because its free tier is enough to generate a full
# 20,000-word handbook end to end.

# Groq -- free tier, default. Key: https://console.groq.com/keys
# Check https://console.groq.com/docs/models for current model IDs.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# xAI Grok -- what the assignment specifies. Swap these three lines.
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.1
# LLM_API_KEY=

# Ollama -- fully local, no key, no network. Slow but free.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=ollama

# Storage -------------------------------------------------------------------
# "local"    BM25 index on disk. No account, no embeddings, works offline.
# "lightrag" knowledge-graph retrieval (pip install "handbook-generator[graph]").
STORAGE_BACKEND=local
WORKING_DIR=./storage

# Only needed if you point LightRAG at Supabase/pgvector instead of local files.
SUPABASE_URL=
SUPABASE_KEY=

# Generation ----------------------------------------------------------------
HANDBOOK_TARGET_WORDS=20000
HANDBOOK_MIN_SECTIONS=12
HANDBOOK_MAX_SECTIONS=24

# Verification --------------------------------------------------------------
# A section is regenerated when it fails one of these checks.
VERIFY_MAX_RETRIES=2
VERIFY_MIN_GROUNDING=0.35
VERIFY_MAX_SIMILARITY=0.75
VERIFY_MIN_WORD_RATIO=0.70
